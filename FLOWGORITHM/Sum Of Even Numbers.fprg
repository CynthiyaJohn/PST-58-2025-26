<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Circumference of a circle"/>
        <attribute name="authors" value="Sharon"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-01-11 08:31:31 PM"/>
        <attribute name="created" value="U2hhcm9uO0xBUFRPUC1WOTA1TjZTUTsyMDI2LTAxLTA4OzA5OjEzOjQ4IEFNOzI5NDE="/>
        <attribute name="edited" value="U2hhcm9uO0xBUFRPUC1WOTA1TjZTUTsyMDI2LTAxLTExOzA4OjMxOjMxIFBNOzI7MzA1MA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sum, i" type="Integer" array="False" size=""/>
            <assign variable="sum" expression="0"/>
            <assign variable="i" expression="1"/>
            <while expression="i&lt;=100">
                <assign variable="sum" expression="sum+i"/>
                <assign variable="i" expression="i+2"/>
            </while>
            <output expression="&quot;The Sum Of Even Numbers is &quot; &amp;sum" newline="True"/>
        </body>
    </function>
</flowgorithm>
