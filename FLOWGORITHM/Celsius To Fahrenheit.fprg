    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="C" type="Real" array="False" size=""/>
            <declare name="F" type="Real" array="False" size=""/>
            <output expression="&quot;Enter Celsius Temperature:&quot;" newline="True"/>
            <input variable="C"/>
            <assign variable="F" expression="C*9/5+32"/>
            <output expression="C &amp;&quot; Celsius is &quot;&amp;F&amp;&quot; Fahrenheit&quot;" newline="True"/>
        </body>
    </function>
