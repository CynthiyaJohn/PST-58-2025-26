<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="sub of 2 numbers"/>
        <attribute name="authors" value="Sharon"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-01-11 04:27:33 PM"/>
        <attribute name="created" value="U2hhcm9uO0xBUFRPUC1WOTA1TjZTUTsyMDI2LTAxLTA2OzEwOjAxOjQzIEFNOzI5MjM="/>
        <attribute name="edited" value="U2hhcm9uO0xBUFRPUC1WOTA1TjZTUTsyMDI2LTAxLTExOzA0OjI3OjMzIFBNOzc7MzA1OA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, num3" type="Integer" array="False" size=""/>
            <input variable="num1"/>
            <input variable="num2"/>
            <input variable="num3"/>
            <if expression="num1&gt;=num2">
                <then>
                    <if expression="num1&gt;=num3">
                        <then>
                            <output expression="&quot;The Greatest Number is&quot;&amp;num1" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;The Greatest Number is&quot;&amp;num3" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="num2&gt;=num3">
                        <then>
                            <output expression="&quot;The Greatest Number is&quot;&amp;num2" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;The Greatest Number is&quot;&amp;num3" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
